<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#44f85149" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="@color/accent_error" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#22f85149" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#66f85149" />
        </shape>
    </item>
</selector>