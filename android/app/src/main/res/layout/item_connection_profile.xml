<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="16dp"
    android:layout_marginBottom="12dp"
    android:elevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_pill"
            android:layout_marginEnd="12dp">
            <ImageView
                android:id="@+id/iv_profile_icon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_server"
                android:contentDescription="" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tv_profile_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Server Profile"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/tv_profile_endpoint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="192.168.1.100:6080/websockify"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="3dp"
                android:maxLines="1"
                android:ellipsize="middle" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_profile_connect"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="112dp"
            android:text="Connect"
            android:textSize="13sp"
            android:textColor="@color/on_primary"
            android:textStyle="bold"
            android:drawableEnd="@drawable/ic_connect"
            android:drawableTint="@color/on_primary"
            android:drawablePadding="6dp"
            android:background="@drawable/bg_button_primary"
            android:paddingStart="14dp"
            android:paddingEnd="12dp"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="10dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/badge_protocol"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="WSS"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:background="@drawable/bg_pill"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/badge_mode"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="Trackpad"
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:background="@drawable/bg_pill"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_marginEnd="6dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btn_profile_edit"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_button_secondary"
            android:src="@drawable/ic_edit"
            android:tint="@color/text_secondary"
            android:padding="12dp"
            android:contentDescription="Edit profile"
            android:layout_marginEnd="8dp" />

        <ImageButton
            android:id="@+id/btn_profile_delete"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_button_danger"
            android:src="@drawable/ic_delete"
            android:tint="@color/accent_error"
            android:padding="12dp"
            android:contentDescription="Delete profile" />
    </LinearLayout>
</LinearLayout>
